{
  "name": "stereovisor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first image-to-parallax desktop studio",
  "author": "Stereovisor",
  "main": "client/dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:service\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:app": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config client/vite.config.mts --host 127.0.0.1",
    "predev:electron": "tsc -p client/tsconfig.electron.json",
    "dev:electron": "wait-on http://127.0.0.1:5173/ && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:service": "node scripts/platform-runner.mjs service",
    "i18n:generate": "node client/scripts/generate-locales.mjs",
    "i18n:check": "node client/scripts/generate-locales.mjs --check",
    "prebuild": "npm run i18n:generate",
    "build": "tsc -p client/tsconfig.electron.json && vite build --config client/vite.config.mts",
    "package": "node scripts/package.mjs",
    "package:mac": "sh scripts/prepare-macos-runtime.sh && npm run build && electron-builder --mac dmg zip --arm64",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:installer": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p client/tsconfig.electron.json --noEmit",
    "test": "vitest run --config client/vite.config.mts",
    "test:service": "node scripts/platform-runner.mjs test-service",
    "smoke": "node scripts/platform-runner.mjs smoke",
    "smoke:package:mac": "node scripts/smoke-test-macos.mjs --packaged",
    "setup": "node scripts/platform-runner.mjs setup-core",
    "openapi": "node scripts/platform-runner.mjs openapi",
    "check": "npm run i18n:check && npm run typecheck && npm test && npm run test:service && npm run build",
    "prestart": "npm run build",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "i18next": "^26.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.13",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "jsdom": "27.4.0",
    "papaparse": "^5.7.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.stereovisor.app",
    "productName": "Stereovisor",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "client/dist/**/*",
      "client/dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "service",
        "to": "service",
        "filter": [
          "**/*.py",
          "**/*.ps1",
          "**/*.sh",
          "**/*.txt",
          "!**/.models{,/**}",
          "!**/.projects{,/**}",
          "!**/__pycache__{,/**}"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.py",
          "**/*.ps1",
          "**/*.mjs",
          "**/*.sh",
          "**/*.txt",
          "!**/__pycache__{,/**}"
        ]
      },
      {
        "from": ".cache/vendor",
        "to": ".cache/vendor",
        "filter": [
          "**/*",
          "!**/.git{,/**}"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "client/public/app-icon.png",
      "signAndEditExecutable": false,
      "signExecutable": false,
      "extraResources": [
        {
          "from": ".venv",
          "to": ".venv",
          "filter": ["**/*", "!**/__pycache__{,/**}", "!**/*.pyc"]
        },
        {
          "from": ".venv-ai",
          "to": ".venv-ai",
          "filter": ["**/*", "!**/__pycache__{,/**}", "!**/*.pyc"]
        },
        {
          "from": ".venv-powerpaint",
          "to": ".venv-powerpaint",
          "filter": ["**/*", "!**/__pycache__{,/**}", "!**/*.pyc"]
        }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "client/public/app-icon.png",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Stereovisor-${version}-mac-arm64.${ext}",
      "extraResources": [
        {
          "from": ".python-runtime",
          "to": ".python-runtime",
          "filter": ["**/*", "!**/__pycache__{,/**}", "!**/*.pyc"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stereovisor"
    },
    "portable": {
      "artifactName": "Stereovisor-${version}-portable.${ext}"
    },
    "artifactName": "Stereovisor-${version}-setup.${ext}"
  }
}
