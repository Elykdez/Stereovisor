{
  "name": "stereovisor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first image-to-parallax desktop studio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:service\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 tcp:5179 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-service.ps1",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-service.ps1",
    "check": "npm run typecheck && npm test && npm run test:service && npm run build",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
